{
  "name": "caching-presentasjon",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "format:check": "prettier --check .",
    "start": "node server.mjs",
    "dev": "pnpm run build && node server.mjs"
  },
  "devDependencies": {
    "prettier": "3.7.4",
    "typescript": "7.0.2"
  }
}
